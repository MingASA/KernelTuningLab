{
  "schema_version": 1,
  "kind": "research",
  "name": "production-marlin085-smoke-v1",
  "plugins": [
    "kernel_tuning_lab.production.marlin"
  ],
  "algorithms": [
    "grid@1.0.0"
  ],
  "dtypes": [
    "float16"
  ],
  "seeds": [
    7
  ],
