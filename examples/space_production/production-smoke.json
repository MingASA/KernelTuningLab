        "production/marlin_explicit@1.0.0"
      ],
      "shapes": [
        {
          "M": 1,
          "N": 512,
          "K": 2048
        }
      ]
    },
    {
      "name": "prefill",
      "operator": "w4a16_gemm@2.0.0",
      "split": "validation",
      "kernels": [
        "production/marlin_default@1.0.0",
        "production/marlin_atomic_opt_in@1.0.0",
        "production/marlin_explicit@1.0.0"
      ],
      "shapes": [
        {
          "M": 64,
          "N": 2048,
          "K": 1024
        }
      ]
    }
  ]
}
