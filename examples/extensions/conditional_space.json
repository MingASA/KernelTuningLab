{
  "schema_version": 2,
  "name": "mixed-conditional-space",
  "plugins": ["conditional_kernel.py", "search_algorithm.py"],
  "operator": "gemm@1.0.0",
  "kernels": ["demo/conditional_gemm@1.0.0"],
