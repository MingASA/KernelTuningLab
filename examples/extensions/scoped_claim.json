{
  "schema_version": 2,
  "name": "scoped-submitters-claim-and-direct-reference-evidence",
  "plugins": ["claimed_kernel.py"],
  "operator": "gemm@1.0.0",
  "kernels": ["demo/claimed_gemm@1.0.0"],
  "algorithms": ["random@1.0.0"],
  "dtype": "float32",
  "shapes": [{"M": 2, "N": 3, "K": 5}, {"M": 5, "N": 7, "K": 3}],
  "budget": {"max_evaluations": 3, "max_wall_time_s": 10},
  "validation": {"max_configs": 8, "max_cases": 2, "max_wall_time_s": 15, "trust_claims": true},
  "warmup": 1,
  "repetitions": 3
}
